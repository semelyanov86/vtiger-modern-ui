{
  "name": "modernui-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Vue 3 islands, settings pages and skin of the ModernUI module for Vtiger CRM 8.4",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.66.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "happy-dom": "21.0.4",
    "sass-embedded": "1.107.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
