{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "./tsconfig.strict.json"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.json",
    "build/**/*.ts",
    "../tests/fixtures/*.json"
  ]
}
