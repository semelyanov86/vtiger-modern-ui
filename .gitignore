# Local settings and state of the dev environment
/.env
/.local/

# Maintainer-only files: notes on running the AI agent prompts, installation-specific information
/USAGE.md
/PRIVATE.md

# Build and release output
/dist/
node_modules/
__pycache__/

# Test runs, browser artefacts (may contain data of the CRM copy)
test-results/
playwright-report/
/.playwright-mcp/
*.log

# Production build of the frontend (task build), packed into the ZIP by task package
/src/layouts/v7/modules/ModernUI/resources/dist/
/frontend/node_modules/

# go-task checksums of up-to-date tasks
/.task/
