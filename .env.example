# Local settings of the ModernUI development environment: copy to .env (never committed).

# Local Vtiger 8.4 instance that `task crm:link` connects src/ to (the "dev instance"). Required.
CRM_ROOT=/var/www/vtiger
CRM_URL=http://vtiger.test/
# PHP CLI able to load the instance's config.inc.php (task crm:status reads the instance DB with it).
CRM_PHP=php8.5
# PHP error log of the instance: PHP errors of ModernUI pages land here.
CRM_FPM_LOG=/var/log/php8.5-fpm.log

# Admin account for browser tests. Prefer CRM_ADMIN_PASS_FILE (a dotenv file that already holds
# ADMIN_PASS=...) over a password written here.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASS=
CRM_ADMIN_PASS_FILE=

# Git checkout of the official Vtiger repository with the tag 8.4.0 (https://code.vtiger.com/vtiger/vtigercrm).
# task test:package unpacks the ZIP with the vtlib importer of that tag; without it the check fails as skipped.
VTIGER_SRC_REPO=

# Clean Vtiger 8.4.0 stand (dev/clean, task clean:*): ports of the gateway on 127.0.0.1 — c81 (PHP 8.1, site root),
# c85 (PHP 8.5, /vtigercrm/), the mail trap. Passwords are generated into .local/clean/secrets.env.
MU_CLEAN_PORT=8481
MU_CLEAN85_PORT=8485
MU_CLEAN_MAIL_PORT=8425
# Optional: a local copy of vtigercrm8.4.0.tar.gz (same SHA-256) instead of the download; instances to manage.
MU_CLEAN_TARBALL=
MU_CLEAN_INSTANCES=c81 c85
