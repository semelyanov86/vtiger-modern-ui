# Local settings of the ModernUI development environment: copy to .env (never committed).

# Local Vtiger 8.4 instance that `task crm:link` connects src/ to (the "dev instance"). Required.
CRM_ROOT=/var/www/vtiger
CRM_URL=http://vtiger.test/
# PHP CLI able to load the instance's config.inc.php (task crm:status reads the instance DB with it).
CRM_PHP=php8.5
# PHP error log of the instance: PHP errors of ModernUI pages land here.
CRM_FPM_LOG=/var/log/php8.5-fpm.log

# Admin account for browser tests. Prefer CRM_ADMIN_PASS_FILE (a dotenv file that already holds
# ADMIN_PASS=...) over a password written here.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASS=
CRM_ADMIN_PASS_FILE=
